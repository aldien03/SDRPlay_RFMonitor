{
  "name": "rf-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev -- --port 4173 --strictPort\"",
    "build": "npm run build:client && npm run build:server && node scripts/generate-release-metadata.mjs",
    "build:client": "vite build && node scripts/prepare-sites-build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check": "tsc --noEmit && vitest run",
    "validate:config": "node dist/server-node/validate-config.js",
    "validate:release": "/usr/bin/node scripts/validate-release-package.mjs",
    "validate:v1": "/usr/bin/node scripts/generate-v1-validation-record.mjs",
    "validate:v2": "/usr/bin/node scripts/run-v2-process-storage-qualification.mjs",
    "validate:v3": "/usr/bin/node scripts/run-v3-packaged-browser-qualification.mjs",
    "validate:v0": "/usr/bin/node dist/server-node/traceability.js",
    "validate:v4:detector": "/usr/bin/node dist/server-node/synthetic-qualification-campaign.js",
    "validate:v4:packaged": "/usr/bin/node scripts/run-v4-packaged-qualification.mjs",
    "validate:v4": "/usr/bin/node dist/server-node/v4-combine-qualification.js",
    "validate:v5:replay": "/usr/bin/node dist/server-node/held-out-replay-qualification.js",
    "validate:v6:conducted": "/usr/bin/node dist/server-node/conducted-rf-qualification.js",
    "validate:v7": "/usr/bin/node scripts/run-long-qualification.mjs v7",
    "deploy:release": "/usr/bin/node deploy/release-cli.mjs",
    "deploy:legacy-snapshot": "/usr/bin/node deploy/legacy-install-snapshot.mjs",
    "preview": "vite preview",
    "start": "node dist/server-node/index.js",
    "verify:sdrconnect": "node scripts/verify-sdrconnect.mjs",
    "verify:evidence": "/usr/bin/node dist/server-node/evidence-verifier.js",
    "backup:evidence": "/usr/bin/node dist/server-node/evidence-backup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "^4.13.0",
    "concurrently": "^9.1.2",
    "esbuild": "0.28.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
