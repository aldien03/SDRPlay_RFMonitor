{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rf-monitor.invalid/schemas/v7-backup-restore-v1.json",
  "title": "RF Monitor V7 witnessed off-host backup and restore proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "identityDigest", "faultPhaseId", "completedAt", "witness", "outcome", "backup", "restore", "evidenceFiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "rf-monitor-v7-backup-restore" },
    "identityDigest": { "$ref": "#/$defs/hash" },
    "faultPhaseId": { "$ref": "#/$defs/id" },
    "completedAt": { "type": "string", "format": "date-time" },
    "witness": { "$ref": "#/$defs/witness" },
    "outcome": { "const": "PASS" },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "performedAt", "packageSha256", "verificationSha256", "offHost", "independentlyVerified", "recoveryPointAgeSeconds"],
      "properties": {
        "outcome": { "const": "PASS" },
        "performedAt": { "type": "string", "format": "date-time" },
        "packageSha256": { "$ref": "#/$defs/hash" },
        "verificationSha256": { "$ref": "#/$defs/hash" },
        "offHost": { "const": true },
        "independentlyVerified": { "const": true },
        "recoveryPointAgeSeconds": { "type": "number", "minimum": 0, "maximum": 3600 }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "performedAt", "verificationSha256", "recoveryTimeSeconds", "fieldTestDomainsSeparated", "evidenceVerified", "independentlyVerified"],
      "properties": {
        "outcome": { "const": "PASS" },
        "performedAt": { "type": "string", "format": "date-time" },
        "verificationSha256": { "$ref": "#/$defs/hash" },
        "recoveryTimeSeconds": { "type": "number", "minimum": 0, "maximum": 14400 },
        "fieldTestDomainsSeparated": { "const": true },
        "evidenceVerified": { "const": true },
        "independentlyVerified": { "const": true }
      }
    },
    "evidenceFiles": { "$ref": "#/$defs/evidenceFiles" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" },
    "witness": { "type": "object", "additionalProperties": false, "required": ["id", "algorithm", "signedAt", "publicKeySha256", "signatureBase64"], "properties": { "id": { "type": "string", "minLength": 1 }, "algorithm": { "const": "Ed25519" }, "signedAt": { "type": "string", "format": "date-time" }, "publicKeySha256": { "$ref": "#/$defs/hash" }, "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 100 } } },
    "evidenceFiles": { "type": "array", "minItems": 3, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } } } }
  }
}
