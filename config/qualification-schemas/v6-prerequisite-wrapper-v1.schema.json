{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rf-monitor.local/schemas/v6-prerequisite-wrapper-v1.schema.json",
  "title": "RF Monitor V6 exact V0-V5 prerequisite wrapper",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "gate", "decision", "completedAt", "release", "configurationSha256", "sources", "sourceSetSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "rf-monitor-v6-prerequisite-wrapper" },
    "gate": { "enum": ["V0", "V1", "V2", "V3", "V4", "V5"] },
    "decision": { "const": "passed" },
    "completedAt": { "type": "string", "format": "date-time" },
    "release": { "$ref": "v6-approved-binding-v1.schema.json#/$defs/release" },
    "configurationSha256": { "$ref": "#/$defs/hash" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifactPath", "artifactSha256"],
        "properties": {
          "role": {
            "enum": [
              "traceability-report",
              "validation-record",
              "qualification-record",
              "browser-result",
              "packaged-result",
              "detector-result",
              "combined-result",
              "bundle-manifest",
              "replay-result",
              "verification-record"
            ]
          },
          "artifactPath": { "$ref": "#/$defs/path" },
          "artifactSha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "sourceSetSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
