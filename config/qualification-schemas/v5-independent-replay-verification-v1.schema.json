{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rf-monitor.local/schemas/v5-independent-replay-verification-v1.schema.json",
  "title": "RF Monitor V5 independent replay verification receipt used by V6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "publicKeyPem", "verifierKeySha256", "statement", "statementSha256", "signatureAlgorithm", "signatureBase64"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "rf-monitor-v5-replay-verification" },
    "publicKeyPem": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "verifierKeySha256": { "$ref": "#/$defs/hash" },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "purpose", "gate", "outcome", "verifiedAt", "release", "configurationSha256", "bundleManifestSha256", "reportSha256", "v5WitnessKeySha256", "verifierIdentitySha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "purpose": { "const": "rf-monitor-v5-independent-replay-verification" },
        "gate": { "const": "V5" },
        "outcome": { "const": "PASS" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "release": { "$ref": "v6-approved-binding-v1.schema.json#/$defs/release" },
        "configurationSha256": { "$ref": "#/$defs/hash" },
        "bundleManifestSha256": { "$ref": "#/$defs/hash" },
        "reportSha256": { "$ref": "#/$defs/hash" },
        "v5WitnessKeySha256": { "$ref": "#/$defs/hash" },
        "verifierIdentitySha256": { "$ref": "#/$defs/hash" }
      }
    },
    "statementSha256": { "$ref": "#/$defs/hash" },
    "signatureAlgorithm": { "const": "ed25519" },
    "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 100 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
