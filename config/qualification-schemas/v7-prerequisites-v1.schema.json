{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rf-monitor.invalid/schemas/v7-prerequisites-v1.json",
  "title": "RF Monitor V7 exact-candidate prerequisites v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "identityDigest", "installedChainFingerprintSha256", "completedAt", "outcome", "gates", "claims", "evidenceFiles", "witness"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "rf-monitor-v7-prerequisites" },
    "identityDigest": { "$ref": "#/$defs/hash" },
    "installedChainFingerprintSha256": { "$ref": "#/$defs/hash" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": { "const": "PASS" },
    "gates": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": { "type": "object", "additionalProperties": false, "required": ["gate", "outcome", "artifactSha256"], "properties": { "gate": { "enum": ["V0", "V1", "V2", "V3", "V4", "V5", "V6"] }, "outcome": { "const": "PASS" }, "artifactSha256": { "$ref": "#/$defs/hash" } } }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["v2AcceptedAttributionInvariantViolations", "v5RealReceiverDerivedFftOnly", "v5SyntheticOrTestInputsAccepted", "v6PhysicalInstalledChain", "v6InstalledChainFingerprintSha256"],
      "properties": { "v2AcceptedAttributionInvariantViolations": { "const": 0 }, "v5RealReceiverDerivedFftOnly": { "const": true }, "v5SyntheticOrTestInputsAccepted": { "const": 0 }, "v6PhysicalInstalledChain": { "const": true }, "v6InstalledChainFingerprintSha256": { "$ref": "#/$defs/hash" } }
    },
    "evidenceFiles": { "$ref": "#/$defs/evidenceFiles" },
    "witness": { "$ref": "#/$defs/witness" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "witness": { "type": "object", "additionalProperties": false, "required": ["id", "algorithm", "signedAt", "publicKeySha256", "signatureBase64"], "properties": { "id": { "type": "string", "minLength": 1 }, "algorithm": { "const": "Ed25519" }, "signedAt": { "type": "string", "format": "date-time" }, "publicKeySha256": { "$ref": "#/$defs/hash" }, "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 100 } } },
    "evidenceFiles": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } } } }
  }
}
