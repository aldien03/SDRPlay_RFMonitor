{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rf-monitor.invalid/schemas/v7-load-exercise-v1.json",
  "title": "RF Monitor V7 witnessed bounded load and evidence exercise v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "identityDigest", "startedAt", "endedAt", "completedAt", "outcome", "engineerDashboards", "ninthDashboardRejected",
    "alertEvidenceRateHz", "exportDownloadBytesPerSecond", "liveTrafficBytesPerSecond", "liveBurstBytes", "applicationEgressBytesPerSecond",
    "visibleDiagnosticsBytesPerSecondPerClient", "maxPerClientQueuedBytes", "maxControlStateBytes", "maxWriterQueueItems", "maxWriterQueueBytes",
    "maxWriterAgeMs", "maxSpectrumRingSeconds", "maxSpectrumRingRateHz", "maxWaterfallRowsPerTarget", "maxStoredSpectrumBins", "maxRawChunkBytes",
    "maxSessionBytes", "maxSessionDurationMs", "maxIncidentExportPartBytes", "alertEvidenceLoss", "clearEvidenceFramesRecorded", "clearEvidenceFramesLost",
    "evidenceLoss", "evidenceSha256", "evidenceFiles", "witness"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "rf-monitor-v7-load-exercise" },
    "identityDigest": { "$ref": "#/$defs/hash" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "outcome": { "const": "PASS" },
    "engineerDashboards": { "const": 8 },
    "ninthDashboardRejected": { "const": true },
    "alertEvidenceRateHz": { "type": "number", "minimum": 4 },
    "exportDownloadBytesPerSecond": { "const": 5242880 },
    "liveTrafficBytesPerSecond": { "type": "number", "minimum": 0, "maximum": 1048576 },
    "liveBurstBytes": { "type": "number", "minimum": 0, "maximum": 2097152 },
    "applicationEgressBytesPerSecond": { "type": "number", "minimum": 0, "maximum": 6291456 },
    "visibleDiagnosticsBytesPerSecondPerClient": { "type": "number", "minimum": 0, "exclusiveMaximum": 16384 },
    "maxPerClientQueuedBytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
    "maxControlStateBytes": { "type": "integer", "minimum": 0, "maximum": 131072 },
    "maxWriterQueueItems": { "type": "integer", "minimum": 0, "exclusiveMaximum": 64 },
    "maxWriterQueueBytes": { "type": "integer", "minimum": 0, "exclusiveMaximum": 2097152 },
    "maxWriterAgeMs": { "type": "number", "minimum": 0, "exclusiveMaximum": 2000 },
    "maxSpectrumRingSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
    "maxSpectrumRingRateHz": { "type": "number", "minimum": 0, "maximum": 4 },
    "maxWaterfallRowsPerTarget": { "type": "integer", "minimum": 0, "maximum": 32 },
    "maxStoredSpectrumBins": { "type": "integer", "minimum": 0, "maximum": 2048 },
    "maxRawChunkBytes": { "type": "integer", "minimum": 0, "maximum": 134217728 },
    "maxSessionBytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
    "maxSessionDurationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "maxIncidentExportPartBytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
    "alertEvidenceLoss": { "const": 0 },
    "clearEvidenceFramesRecorded": { "type": "integer", "minimum": 1 },
    "clearEvidenceFramesLost": { "type": "integer", "minimum": 0 },
    "evidenceLoss": { "const": 0 },
    "evidenceSha256": { "$ref": "#/$defs/hash" },
    "evidenceFiles": { "$ref": "#/$defs/evidenceFiles" },
    "witness": { "$ref": "#/$defs/witness" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "witness": { "type": "object", "additionalProperties": false, "required": ["id", "algorithm", "signedAt", "publicKeySha256", "signatureBase64"], "properties": { "id": { "type": "string", "minLength": 1 }, "algorithm": { "const": "Ed25519" }, "signedAt": { "type": "string", "format": "date-time" }, "publicKeySha256": { "$ref": "#/$defs/hash" }, "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 100 } } },
    "evidenceFiles": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } } } }
  }
}
