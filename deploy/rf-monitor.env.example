RF_MONITOR_REQUIRE_EXPLICIT_CONFIG=true
RF_MONITOR_HOST=127.0.0.1
RF_MONITOR_PORT=8080
RF_MONITOR_STORAGE=/var/lib/rf-monitor/evidence
RF_MONITOR_CATALOG_FILE=/etc/rf-monitor/catalog.json
RF_MONITOR_OPERATIONAL_FILE=/var/lib/rf-monitor/config/operational.json
RF_MONITOR_ADMIN_FILE=/etc/rf-monitor/admin.json
RF_MONITOR_ADMIN_SESSION_MINUTES=15
# WSL test labs only; never set this on a production evidence host.
# RF_MONITOR_WSL_TEST_MODE=true
RF_MONITOR_SIMULATION=off
RF_MONITOR_IQ_CAPTURE_MS=0
RF_MONITOR_IQ_MAX_BYTES=67108864
# Runtime work budgets. Keep these defaults unless commissioning data supports a change.
RF_MONITOR_SPECTRUM_RATE_HZ=4
RF_MONITOR_MAX_SPECTRUM_BINS=2048
RF_MONITOR_EVIDENCE_FRAME_INTERVAL_MS=2000
RF_MONITOR_MAX_PENDING_EVIDENCE_FRAMES=8

SDRCONNECT_URL=ws://127.0.0.1:5454/
SDRCONNECT_TIMEOUT_MS=3000
SDRCONNECT_SAMPLE_RATE_HZ=10000000
SDRCONNECT_DEVICE_INDEX=0
SDRCONNECT_TLS_REJECT_UNAUTHORIZED=true

# SDRconnect 1.0.10 headless WSS, when enabled.
# SDRCONNECT_URL=wss://127.0.0.1:5454/
# NODE_EXTRA_CA_CERTS=/etc/rf-monitor/sdrconnect-ca.pem

# Optional: comma-separated endpoints for a two-receiver deployment.
# RF Monitor 1.0 accepts exactly one loopback SDRconnect endpoint.

# Needed only when the dashboard is intentionally served from another origin.
# RF_MONITOR_ALLOWED_ORIGINS=https://rf-monitor.example.internal
