[Unit]
Description=RF Monitor daily external readiness record
After=network-online.target time-sync.target rf-monitor.service
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=@@SERVICE_USER@@
Group=@@SERVICE_GROUP@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@CONFIG_FILE@@
EnvironmentFile=-/etc/rf-monitor/ops.conf
Environment=RFMON_INSTALL_DIR=@@INSTALL_DIR@@
Environment=RFMON_OPS_ARCHIVE_DIR=/var/lib/rf-monitor-ops
StateDirectory=rf-monitor-ops
StateDirectoryMode=0750
ExecStart=/usr/bin/node @@INSTALL_DIR@@/deploy/ops-supervisor.mjs daily
TimeoutStartSec=60s
Nice=10
CPUWeight=10
IOWeight=10
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rf-monitor-ops
UMask=0027

