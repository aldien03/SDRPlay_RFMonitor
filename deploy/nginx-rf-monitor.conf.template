server {
    listen 443 ssl;
    server_name @@SERVER_NAME@@;

    ssl_certificate @@TLS_CERTIFICATE@@;
    ssl_certificate_key @@TLS_PRIVATE_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 6m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    keepalive_requests 256;
    reset_timedout_connection on;

    allow @@OPERATOR_CIDR@@;
    deny all;

    # Live control/data protocol: WebSocket only. The application enforces the
    # global eight-client and aggregate bandwidth/queue budgets.
    location = /live {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }

    # Only the download phase streams directly. Export creation/status and the
    # one-release legacy creation routes remain ordinary bounded JSON APIs.
    # limit_rate is defense in depth per response; RF Monitor remains
    # authoritative for the single global 5 MiB/s export budget.
    location ~ ^/api/exports/[^/]+/download$ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        limit_rate 5m;
    }

    # Static files and ordinary JSON APIs use bounded buffering and cannot
    # accidentally inherit WebSocket upgrade semantics. limit_rate is a
    # per-response guard; the application separately caps normal requests at
    # 64 in flight and exposes HTTP + WebSocket egress in /api/health. Nginx
    # limit_req_zone/limit_conn_zone directives belong in the http context and
    # therefore must not be placed in this server-only include.
    location / {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_max_temp_file_size 8m;
        limit_rate_after 128k;
        limit_rate 1m;
    }
}
