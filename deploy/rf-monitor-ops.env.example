# Root-owned, mode 0640. This file contains paths and thresholds only.
RFMON_OPS_HEALTH_URL=http://127.0.0.1:8080/api/health
RFMON_OPS_STORAGE_DIR=/var/lib/rf-monitor/evidence
RFMON_OPS_EVIDENCE_ROOTS=/var/lib/rf-monitor/evidence/field/evidence,/var/lib/rf-monitor/evidence/test/evidence
RFMON_OPS_BACKUP_ROOT=/media/rf-monitor-backup
RFMON_OPS_RESTORE_STAGING_ROOT=/var/lib/rf-monitor/restore-drills
RFMON_OPS_TLS_CERTIFICATE=/etc/rf-monitor/tls/rf-monitor.crt
RFMON_OPS_DISK_RESERVE_BYTES=5368709120

# Bounded record retention: about 13 months daily, two years weekly, three years monthly.
RFMON_OPS_DAILY_RECORDS=400
RFMON_OPS_WEEKLY_RECORDS=104
RFMON_OPS_MONTHLY_RECORDS=36

# A completed backup older than 36 hours creates Attention.
RFMON_OPS_BACKUP_MAX_AGE_MS=129600000
# Weekly and monthly missed-task grace windows.
RFMON_OPS_WEEKLY_MAX_AGE_MS=777600000
RFMON_OPS_MONTHLY_MAX_AGE_MS=3456000000

# Each verifier subprocess is capped at 30 minutes; each weekly/monthly job is
# capped below its six-hour systemd unit timeout so it can still publish a
# failed record instead of disappearing.
RFMON_OPS_VERIFICATION_TIMEOUT_MS=1800000
RFMON_OPS_WEEKLY_JOB_MAX_MS=18000000
RFMON_OPS_MONTHLY_JOB_MAX_MS=18000000
