[Unit]
Description=RF Monitor weekly evidence and backup verification
After=local-fs.target

[Service]
Type=oneshot
User=@@SERVICE_USER@@
Group=@@SERVICE_GROUP@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@CONFIG_FILE@@
EnvironmentFile=-/etc/rf-monitor/ops.conf
Environment=RFMON_INSTALL_DIR=@@INSTALL_DIR@@
Environment=RFMON_OPS_ARCHIVE_DIR=/var/lib/rf-monitor-ops
StateDirectory=rf-monitor-ops
StateDirectoryMode=0750
ExecStart=/usr/bin/node @@INSTALL_DIR@@/deploy/ops-supervisor.mjs weekly
TimeoutStartSec=6h
Nice=15
CPUWeight=5
IOWeight=5
MemoryMax=256M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/rf-monitor-ops
UMask=0027

